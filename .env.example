# =============================================================================
# ZirveTarım Admin — ortam değişkenleri
#
# Bu dosyayı `.env` olarak kopyalayın. `.env` ASLA commit edilmez.
#
# API bu depoda DEĞİL: https://github.com/EmreKaya2000/zirve-tarim-api
# Panelin çalışması için o API'nin ayakta olması gerekir.
# =============================================================================

# -----------------------------------------------------------------------------
# API ADRESLERİ
# -----------------------------------------------------------------------------

# TARAYICIDAN erişilebilen API adresi.
#
# Panelin neredeyse tüm veri akışı tarayıcıdan gider (TanStack Query), bu yüzden
# asıl önemli değer budur. NEXT_PUBLIC_ öneki zorunlu: değer istemci paketine
# DERLEME ANINDA gömülür.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Sunucu tarafı render ve `/uploads` yönlendirmesi için API kökeni.
# Docker içinde servis adı üzerinden konuşulur: http://api:4000/api/v1
INTERNAL_API_URL=http://localhost:4000/api/v1

# -----------------------------------------------------------------------------
# SİTE KİMLİĞİ
# -----------------------------------------------------------------------------

NEXT_PUBLIC_SITE_NAME=Zirve Tarım
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# -----------------------------------------------------------------------------
# ÇALIŞTIRMA
# -----------------------------------------------------------------------------

# Panelin portu. Vitrin 3000 kullanır (ayrı depo, ayrı uygulama).
# API'nin CORS_ORIGINS listesinde bu köken bulunmalıdır.
ADMIN_PORT=3001

# Playwright test sunucusunun portu. Geliştirme sunucusuyla ve vitrinin test
# sunucusuyla (3100) çakışmasın diye ayrıdır. Bu köken de CORS listesinde
# olmalıdır — yoksa testler "Sunucuya ulaşılamadı" ile düşer.
E2E_ADMIN_PORT=3101

# Yönetici kimliği (seed varsayılanları). Testler bunları kullanır.
SEED_SUPER_ADMIN_EMAIL=admin@zirvetarim.local
SEED_SUPER_ADMIN_PASSWORD=ZirveTarim2026
